{
  "name": "vscode-webrtc-collab",
  "displayName": "WebRTC Collab (Yjs)",
  "description": "Peer-to-peer collaborative editing using WebRTC + Yjs CRDT inside a VS Code extension.",
  "version": "1.0.0",
  "publisher": "your-name-here",
  "engines": {
    "vscode": "^1.90.0"
  },
  "main": "./extension.js",
  "activationEvents": [
    "onCommand:webrtcCollab.start"
  ],
  "contributes": {
    "commands": [
      {
        "command": "webrtcCollab.start",
        "title": "WebRTC Collaboration"
      }
    ]
  },
  "scripts": {
    "start": "node signaling-server.js",
    "build": "echo \"No build step needed\""
  },
  "dependencies": {
    "ws": "^8.17.0"
  }
}
