{
  "name": "webrtc-collab-yjs",
  "version": "1.0.0",
  "description": "VS Code WebRTC collaboration extension using Yjs (WebRTC provider) + signaling server",
  "main": "extension.js",
  "scripts": {
    "start": "node server/signaling-server.js",
    "server": "node server/signaling-server.js"
  },
  "activationEvents": [
    "onCommand:webrtcCollab.start"
  ],
  "contributes": {
    "commands": [
      {
        "command": "webrtcCollab.start",
        "title": "Start WebRTC Collaboration"
      }
    ]
  },
  "dependencies": {
    "ws": "^8.18.0"
  }
}